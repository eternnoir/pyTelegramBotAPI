def test_json_giftinfo():
    json_dict = json.loads(r'{"gift": {"id": 123456789, "sticker": {"file_id": "s", "file_unique_id": "su", "type": "regular", "width": 512, "height": 512, "is_animated": false, "is_video": false}, "star_count": 100}, "owned_gift_id": "og_123", "convert_star_count": 50, "prepaid_upgrade_star_count": 100, "can_be_upgraded": true, "text": {"type": "bold", "text": "Gift text"}, "entities": [{"type": "bold", "offset": 0, "length": 4}], "is_private": false, "is_upgrade_separate": false, "unique_gift_number": 42}')
    result = types.GiftInfo.de_json(json_dict)
    assert isinstance(result.gift, types.Gift)
    assert result.owned_gift_id == 'og_123'
    assert result.convert_star_count == 50
    assert result.prepaid_upgrade_star_count == 100
    assert result.can_be_upgraded == True
    assert result.text == {'type': 'bold', 'text': 'Gift text'}
    assert isinstance(result.entities, list)
    assert result.is_private == False
    assert result.is_upgrade_separate == False
    assert result.unique_gift_number == 42
    assert isinstance(result, types.GiftInfo)


